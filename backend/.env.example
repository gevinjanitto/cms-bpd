# Required. Use the MongoDB URI supplied by your database provider.
MONGO_URL=
DB_NAME=cms_bpd_bali
# Comma-separated FRONTEND origins, without trailing slashes.
CORS_ORIGINS=
# Hosting injects PORT. Set a port explicitly for local startup.
PORT=8001
# Required on first startup only; minimum 8 characters.
BOOTSTRAP_PASSWORD=
# true loads synthetic examples; false initializes only the four role accounts.
SEED_SAMPLE_DATA=false
# Optional image storage. Never place the API secret in frontend variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=